{
    "name": "adamb/laravel-postio",
    "description": "Laravel integration for adamb/postio: UK postcode to address lookup on the Postio API with the county filled in",
    "keywords": ["Laravel", "Postio", "postcode", "address lookup", "UK", "county"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Adam Binnersley",
            "email": "abinnersley@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "adamb/postio": "^1.0",
        "illuminate/support": ">=11.0",
        "illuminate/http": ">=11.0",
        "illuminate/cache": ">=11.0",
        "illuminate/validation": ">=11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Postio\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Postio\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Postio\\Laravel\\PostioServiceProvider"
            ],
            "aliases": {
                "AddressLookup": "Postio\\Laravel\\Facades\\AddressLookup"
            }
        }
    }
}
